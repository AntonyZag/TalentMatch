# Copy to `.env` and adjust. `.env` is git-ignored.

# Allowed origins for CORS, comma-separated. Leave unset and every cross-origin
# request is rejected (the app logs a warning). Required for local dev.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Pega la URI del Session Pooler con sslmode=require en tu .env local.
DATABASE_URL=
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=

# Usa un secreto aleatorio de al menos 32 bytes para HS256.
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
